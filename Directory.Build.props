<Project>

  <!--
    Propriedades centralizadas do MSBuild aplicadas a todos os projetos da solução.

    O plano mantém TreatWarningsAsErrors desativado intencionalmente para que os avisos
    sirvam de orientação, em vez de interromper a compilação. NETSDK1138 é suprimido
    porque a avaliação exige net6.0, embora esteja fora de suporte. O SDK do .NET
    inclui NetAnalyzers (habilitados aqui), portanto não é necessária uma referência
    explícita ao pacote; fixar EnableNETAnalyzers + AnalysisMode mantém o comportamento
    consistente entre as versões do SDK usadas localmente e na CI.

    Resumo das supressões por regra:
      * CA1014 — Aviso sobre o atributo CLSCompliant em uma solução exclusiva para net6.0.
      * CA1848 — Sugestão do gerador de código LoggerMessage; neste caso, a legibilidade
        de ILogger.LogInformation/LogError é mais importante que o pequeno ganho de desempenho.
      * CA1873 — Cache de CultureInfo para argumentos de log; os logs encaminhados
        já são gravados no nível Information e o custo é insignificante.
      * CA1305 — APIs dependentes de cultura; corrigidas pontualmente nos testes com
        IFormatProvider e suprimidas nos demais casos, pois a formatação dependente da
        cultura é aceitável na saída de log da avaliação.
  -->

  <PropertyGroup>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors)</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>6.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <NoWarn>$(NoWarn);NETSDK1138;CA1014;CA1848;CA1873;CA1305</NoWarn>
  </PropertyGroup>

</Project>
