<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Configurações do Coverlet usadas por `dotnet test` e pelo fluxo de CI.

    * Format — cobertura é o padrão de fato consumido por indicadores de cobertura
      do GitHub Actions e integrações de revisão de código.
    * ExcludeByAttribute — mantém código gerado e código exclusivo de infraestrutura fora
      da cobertura reportada (migrações, composição de DI, dublês de testes de integração
      e fábricas de tempo de design).
    * ExcludeByFile — as ferramentas de cobertura não devem analisar caminhos inalcançáveis
      dentro do código gerado das migrações.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>Obsolete,GeneratedCode,CompilerGenerated</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/*.cs,**/bin/**,**/obj/**</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
          <IncludeDirectory>**/CandidateAssessment.*/bin/**</IncludeDirectory>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
