<Project>

  <!--
    Aplicado após os targets de cada projeto.

    * Pasta Migrations — o EF Core gera migrações com literais de array em linha
      que acionam CA1861. Corrigi-los manualmente quebra a próxima execução de
      `dotnet ef migrations add`; por isso, CA1861 é suprimido nessa pasta.
    * Projetos de testes — a convenção de nomenclatura `Should_X_When_Y` do xUnit
      aciona CA1707 em todos os métodos de teste. Esse aviso não é relevante para
      a avaliação e, sem a supressão, dominaria a saída da compilação.
  -->

  <PropertyGroup Condition="$(MSBuildProjectName.Contains('Tests'))">
    <NoWarn>$(NoWarn);CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="**/Migrations/*.cs">
      <NoWarn>$(NoWarn);CA1861</NoWarn>
    </Compile>
  </ItemGroup>

</Project>
